<com.android.systemui.shade.SplitNotificationShadeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/split_notification_shade_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Left side: Notifications Panel -->
    <FrameLayout
        android:id="@+id/notification_panel_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.6"
        android:layout_marginEnd="4dp"
        android:background="@drawable/notification_panel_background">

        <com.android.systemui.statusbar.notification.stack.NotificationStackScrollLayout
            android:id="@+id/notification_stack_scroller"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- Right side: Quick Settings Panel -->
    <FrameLayout
        android:id="@+id/quick_settings_panel_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.4"
        android:layout_marginStart="4dp"
        android:background="@drawable/qs_panel_background">

        <FrameLayout
            android:id="@+id/qs_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</com.android.systemui.shade.SplitNotificationShadeLayout>
